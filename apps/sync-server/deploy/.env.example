# The name the server is reached by. Caddy gets a certificate for it automatically.
# For a server only reachable in the home network or over Tailscale, see ../README.md.
BEZIER_DOMAIN=cad.example.org

# Lets someone register without an invite. At least 16 characters. Give it to people you
# trust, or leave it empty after creating your own account and use invites only.
BEZIER_SYNC_ENROLLMENT=

# Where Bezier may call this server from. Empty allows any: the desktop app and any place
# Bezier is served from. Every call needs a token, so this narrows, it does not protect.
BEZIER_SYNC_ORIGINS=

# Space one vault may use, in megabytes. Empty means no limit.
BEZIER_SYNC_QUOTA_MB=

BEZIER_DATA_DIR=./data
BEZIER_REPLICA_DIR=./replica
