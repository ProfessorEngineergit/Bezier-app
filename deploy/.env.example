# Bezier's servers on one machine (deploy/compose.yaml). Copy to deploy/.env and fill it in.

# The names the servers answer to. With the `https` profile Caddy gets certificates for them; behind
# a proxy you already run (nginx, a Cloudflare tunnel) they are only for your own notes.
STORE_DOMAIN=store.example.org
SYNC_DOMAIN=sync.example.org

# Where the data lives on this machine. Back these up.
BEZIER_DATA_DIR=./data
# A second disk or a NAS mount the sync server copies every write to. Leave as is if there is none.
BEZIER_REPLICA_DIR=./replica

# Who may call the store from a browser engine. The desktop app is `tauri://localhost` on macOS and
# Linux and `http://tauri.localhost` on Windows; add the address of a web build if you host one.
# Empty means nobody, and the app then cannot read the store at all.
STORE_ORIGINS=tauri://localhost,http://tauri.localhost

# A code that lets someone make a sync account without an invite (16 characters or more).
# Leave empty for invites only.
BEZIER_SYNC_ENROLLMENT=

# What the store calls itself in the app.
LESSONS_NAME=Bezier Community
PLUGINS_NAME=Bezier Plugins
DOCS_NAME=Bezier Wiki
